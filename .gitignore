# EarthForge local source/reference material
# Store manifests and identifiers in Git; keep licensed/raw imagery local.
projects/*/references/private/
projects/*/references/raw/
projects/*/cache/
projects/*/scratch/
projects/*/downloads/

# Generated heavy outputs
projects/*/outputs/local/
projects/*/outputs/tmp/
projects/*/outputs/cache/

# Build artifacts
build/
dist/
tmp/
temp/
*.log

# Backup files created by drop tools
*.earthforge-backup
