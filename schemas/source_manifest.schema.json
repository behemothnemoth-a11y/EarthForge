{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earthforge.local/schemas/source_manifest.schema.json",
  "title": "EarthForge Source Manifest",
  "type": "object",
  "required": [
    "source_id",
    "provider",
    "source_type"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "external_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "acquired_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage": {},
    "license_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "redistributable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "local_private_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
